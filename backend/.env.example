# Backend environment variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string from your cloud provider (Supabase, Railway, Neon, etc.)
# Example (Supabase): postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Example (Railway):  postgresql://postgres:[password]@containers-us-west-X.railway.app:XXXX/railway
DATABASE_URL=postgresql://user:password@host:5432/dbname

# A long random secret key for signing JWT tokens (generate one with: openssl rand -hex 32)
SECRET_KEY=replace-this-with-a-long-random-string
