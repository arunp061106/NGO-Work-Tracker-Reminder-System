# Backend environment variables
# Copy this file to .env for local development
# In production, add these as Vercel Environment Variables in your project dashboard.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon connection string (use the pooled endpoint for serverless):
# DATABASE_URL=postgresql://neondb_owner:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-long-random-string
